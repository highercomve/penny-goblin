<style>
  sync-conflict: background=#ffdad6
  n2: color=#191d19
  @media (prefers-color-scheme: dark) {
    sync-conflict: background=#93000a
    n2: color=#e0e4dc
  }

  @when (hover) {
    sync-conflict: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    sync-conflict: background=#384a3b
  }
  @when (focus) {
    sync-conflict: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<row id="sync-conflict" class="sync-conflict" justify="flex-start" align="center" width="100%" min-height="48" margin="0,0,8,0" padding="0,24,0,24" row-gap="8" column-gap="8" radius="12" clickable="true" unset="shrink color font-size">
  <text class="n2" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">{text}</text>
</row>
