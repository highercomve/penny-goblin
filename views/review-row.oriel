<style>
  review-row: background=#e4e9de
  n2: color=#191d19
  n3: color=#434a43
  n5: color=#191d19
  choice: border-color=#737a72 color-scheme=light color=#191d19
  matches: color=#434a43
  state: color=#434a43
  n10: color=#2d6a4f
  @media (prefers-color-scheme: dark) {
    review-row: background=#272b27
    n2: color=#e0e4dc
    n3: color=#c2c9c0
    n5: color=#e0e4dc
    choice: border-color=#8c938a color-scheme=dark color=#e0e4dc
    matches: color=#c2c9c0
    state: color=#c2c9c0
    n10: color=#9ad4ae
  }
  @media (max-width: 839px) {
    review-row: background=#f0f3eb
  }
  @media (max-width: 839px) and (prefers-color-scheme: dark) {
    review-row: background=#191d19
  }
  @media (max-width: 380px) {
    review-row: background=#f0f3eb
  }
  @media (max-width: 380px) and (prefers-color-scheme: dark) {
    review-row: background=#191d19
  }
</style>
<view id="review-row" class="review-row" margin="0" padding="12" radius="16" unset="color font-size">
  <text class="n2" shrink="0" font-size="14" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif"><span font-weight="700">{title}</span></text>
  <text class="n3" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">{detail}</text>
  <row id="choice-field" align="baseline" align-self="flex-start" clickable="true">
    <text class="n5" shrink="0" width="0" min-width="0" font-size="14" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">​</text>
    <select id="choice" class="choice" width="100%" min-height="48" margin="8,0,0,0" padding="0,12,0,12" border-width="1" radius="8" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" value="link:synthetic-payment" label="Decision">
      <option value="">Choose…</option>
      <option value="create">Add as new payment</option>
      <option value="ignore">Ignore</option>
      <option value="link:synthetic-payment">Same as 2026-10-01 · Example shop</option>
    </select>
  </row>
  <text id="matches" class="matches" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">1 possible match</text>
  <text id="state" class="state" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">Linked</text>
  <row id="undo" justify="center" align="center" align-self="flex-start" min-height="40" padding="0,12,0,12" row-gap="8" column-gap="8" radius="20" clickable="true">
    <text class="n10" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Undo</text>
  </row>
</view>
