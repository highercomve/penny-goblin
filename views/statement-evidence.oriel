<style>
  toggle: color=#2d6a4f
  detail: color-scheme=light background=#eaeee4
  n5: color=#191d19
  n7: color=#2d6a4f
  @media (prefers-color-scheme: dark) {
    toggle: color=#9ad4ae
    detail: color-scheme=dark background=#1d211d
    n5: color=#e0e4dc
    n7: color=#9ad4ae
  }
</style>
<view id="statement-evidence" margin="0,0,8,0" unset="color font-size">
  <text id="toggle" class="toggle" shrink="0" margin="0,0,12,0" padding="10,0,10,0" clickable="true" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif"><span>{title}</span><span> ▴</span></text>
  <view id="body" margin="0">
    <view id="detail" class="detail" max-height="260" margin="0,0,12,0" padding="12" scroll="true" scroll-x="true" radius="8">
      <text class="n5" shrink="0" font-size="12" font-weight="400" mono="true" font-family="monospace">{detail}</text>
    </view>
    <row id="save" justify="center" align="center" align-self="flex-start" min-height="40" padding="0,12,0,12" row-gap="8" column-gap="8" radius="20" clickable="true">
      <text class="n7" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Save source</text>
    </row>
  </view>
</view>
