<style>
  scanner-page: grow=1 basis=0 width=640 height=auto min-height=0 max-width=1180 max-height=772 padding=0,24,24,24 color-scheme=light background=#eaeee4 radius=28 unset="position inset z"
  n2: margin=0,-24,8,-24 padding=8,16,0,8 background=#eaeee4
  n4: icon-color=#434a43 viewbox=0,0,24,24
  n6: color=#191d19
  scanner-summary: color=#434a43
  n10: color=#2d6a4f
  scanner-system-row: background=#e4e9de
  n13: color=#2d6a4f
  scanner-installed: background=#e4e9de
  n16: color=#2d6a4f
  scanner-models: background=#e4e9de
  n18: color=#2d6a4f
  n19: background=#e4e9de
  n21: color=#434a43
  model: background=#dce7d6
  n24: color=#17241a
  projector: background=#dce7d6
  n26: color=#17241a
  scanner-fast: border-color=#737a72 color-scheme=light background=#e4e9de
  n29: background=#737a72
  n30: color=#191d19
  scanner-gpu: border-color=#737a72 color-scheme=light background=#e4e9de
  n33: background=#737a72
  scanner-gpu-label: color=#191d19
  n35: color=#434a43
  model-status: color=#434a43
  @media (prefers-color-scheme: dark) {
    scanner-page: color-scheme=dark background=#1d211d
    n2: background=#1d211d
    n4: icon-color=#c2c9c0 viewbox=0,0,24,24
    n6: color=#e0e4dc
    scanner-summary: color=#c2c9c0
    n10: color=#9ad4ae
    scanner-system-row: background=#272b27
    n13: color=#9ad4ae
    scanner-installed: background=#272b27
    n16: color=#9ad4ae
    scanner-models: background=#272b27
    n18: color=#9ad4ae
    n19: background=#272b27
    n21: color=#c2c9c0
    model: background=#384a3b
    n24: color=#d6e8d6
    projector: background=#384a3b
    n26: color=#d6e8d6
    scanner-fast: border-color=#8c938a color-scheme=dark background="rgba(104.5776, 108.92457, 102.495766, 1)"
    n29: background="rgba(131.32571, 138.32571, 129.67268, 1)"
    n30: color=#e0e4dc
    scanner-gpu: border-color=#8c938a color-scheme=dark background="rgba(104.5776, 108.92457, 102.495766, 1)"
    n33: background="rgba(131.32571, 138.32571, 129.67268, 1)"
    scanner-gpu-label: color=#e0e4dc
    n35: color=#c2c9c0
    model-status: color=#c2c9c0
  }
  @media (max-width: 839px) {
    scanner-page: width=393 height=820 max-width=393 max-height=820 padding=0,16,24,16 position=absolute top=0 right=0 bottom=0 left=0 background=#f6f8f1 z=2147483647 unset="grow basis min-height radius"
    n2: margin=0,-16,8,-16 padding=0,12,0,4 background=#f6f8f1
    scanner-system-row: background=#f0f3eb
    scanner-installed: background=#f0f3eb
    scanner-models: background=#f0f3eb
    n19: background=#f0f3eb
    scanner-fast: background="rgba(173.88127, 178.59492, 169.59933, 1)"
    n29: background="rgba(122.15856, 129.15855, 120.87222, 1)"
    scanner-gpu: background="rgba(173.88127, 178.59492, 169.59933, 1)"
    n33: background="rgba(122.15856, 129.15855, 120.87222, 1)"
  }
  @media (max-width: 839px) and (prefers-color-scheme: dark) {
    scanner-page: background=#111511
    n2: background=#111511
    scanner-system-row: background=#191d19
    scanner-installed: background=#191d19
    scanner-models: background=#191d19
    n19: background=#191d19
    scanner-fast: background="rgba(98.40269, 102.71699, 96.516884, 1)"
    n29: background="rgba(132.1425, 139.1425, 130.4568, 1)"
    scanner-gpu: background="rgba(98.40269, 102.71699, 96.516884, 1)"
    n33: background="rgba(132.1425, 139.1425, 130.4568, 1)"
  }
  @media (max-width: 380px) {
    scanner-page: width=320 height=820 max-width=320 max-height=820 padding=0,16,24,16 position=absolute top=0 right=0 bottom=0 left=0 background=#f6f8f1 z=2147483647 unset="grow basis min-height radius"
    n2: margin=0,-16,8,-16 padding=0,12,0,4 background=#f6f8f1
    scanner-system-row: background=#f0f3eb
    scanner-installed: background=#f0f3eb
    scanner-models: background=#f0f3eb
    n19: background=#f0f3eb
    scanner-fast: background="rgba(166.53978, 171.2146, 162.4909, 1)"
    n29: background="rgba(123.12966, 130.12965, 121.804474, 1)"
    scanner-gpu: background="rgba(166.53978, 171.2146, 162.4909, 1)"
    n33: background="rgba(123.12966, 130.12965, 121.804474, 1)"
  }
  @media (max-width: 380px) and (prefers-color-scheme: dark) {
    scanner-page: background=#111511
    n2: background=#111511
    scanner-system-row: background=#191d19
    scanner-installed: background=#191d19
    scanner-models: background=#191d19
    n19: background=#191d19
    scanner-fast: background="rgba(101.595955, 105.92715, 99.60878, 1)"
    n29: background="rgba(131.72011, 138.72011, 130.05132, 1)"
    scanner-gpu: background="rgba(101.595955, 105.92715, 99.60878, 1)"
    n33: background="rgba(131.72011, 138.72011, 130.05132, 1)"
  }

  @when (hover) {
    close-scanner: background=#d0e4c5
    model: background=#d0e4c5
    n29: background=#d0e4c5
    n30: background=#d0e4c5
    n33: background=#d0e4c5
    projector: background=#d0e4c5
    scanner-fast: background=#d0e4c5
    scanner-fast-row: background=#d0e4c5
    scanner-gpu: background=#d0e4c5
    scanner-gpu-label: background=#d0e4c5
    scanner-gpu-row: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    close-scanner: background=#384a3b
    model: background=#384a3b
    n29: background=#384a3b
    n30: background=#384a3b
    n33: background=#384a3b
    projector: background=#384a3b
    scanner-fast: background=#384a3b
    scanner-fast-row: background=#384a3b
    scanner-gpu: background=#384a3b
    scanner-gpu-label: background=#384a3b
    scanner-gpu-row: background=#384a3b
  }
  @when (focus) {
    close-scanner: outline=2,-2,#e59700 outline-halo=#111511
    model: outline=2,-2,#e59700 outline-halo=#111511
    n29: outline=2,-2,#e59700 outline-halo=#111511
    n30: outline=2,-2,#e59700 outline-halo=#111511
    n33: outline=2,-2,#e59700 outline-halo=#111511
    projector: outline=2,-2,#e59700 outline-halo=#111511
    scanner-fast: outline=2,-2,#e59700 outline-halo=#111511
    scanner-fast-row: outline=2,-2,#e59700 outline-halo=#111511
    scanner-gpu: outline=2,-2,#e59700 outline-halo=#111511
    scanner-gpu-label: outline=2,-2,#e59700 outline-halo=#111511
    scanner-gpu-row: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<view id="scanner-page" class="scanner-page" scroll="true" scroll-x="true" unset="shrink color font-size">
  <row class="n2" align="center" min-height="64" row-gap="4" column-gap="4" sticky="0,auto,auto,auto" z="2">
    <row id="close-scanner" justify="center" align="center" width="48" height="48" min-height="48" row-gap="8" column-gap="8" radius="50%" clickable="true" unset="shrink">
      <icon class="n4" grow="0" shrink="0" width="24" height="24" clickable="true">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" linecap="round" linejoin="round" />
      </icon>
    </row>
    <view id="scanner-title" grow="1" shrink="1" basis="0%" clip="true">
      <text class="n6" shrink="0" font-size="22" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true">Receipt scanner</text>
    </view>
    <view grow="0" />
  </row>
  <text id="scanner-summary" class="scanner-summary" shrink="0" margin="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">Status</text>
  <view id="scanner-system">
    <text class="n10" shrink="0" padding="16,4,4,4" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">Built into this phone</text>
    <view id="scanner-system-row" class="scanner-system-row" min-width="0" padding="16" radius="16" />
  </view>
  <view id="scanner-installed-section">
    <text class="n13" shrink="0" padding="16,4,4,4" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">On this device</text>
    <view id="scanner-installed" class="scanner-installed" min-width="0" padding="16" radius="16" />
  </view>
  <view id="scanner-available-section">
    <text class="n16" shrink="0" padding="16,4,4,4" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">Download</text>
    <view id="scanner-models" class="scanner-models" min-width="0" padding="16" radius="16" />
  </view>
  <text class="n18" shrink="0" padding="16,4,4,4" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">Your own model</text>
  <view class="n19" min-width="0" padding="16" radius="16">
    <view id="scanner-custom-row" />
    <text class="n21" shrink="0" padding="12,0,12,0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">A GGUF vision model and its matching projector (mmproj).</text>
    <row wrap="wrap" align="center" margin="12,0,0,0" padding="0,12,12,12" row-gap="8" column-gap="8">
      <row id="model" class="model" justify="center" align="center" min-height="48" padding="0,24,0,24" row-gap="8" column-gap="8" radius="20" opacity="0.38" clickable="true" disabled="true" unset="shrink">
        <text class="n24" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Load model file</text>
      </row>
      <row id="projector" class="projector" justify="center" align="center" min-height="48" padding="0,24,0,24" row-gap="8" column-gap="8" radius="20" opacity="0.38" clickable="true" disabled="true" unset="shrink">
        <text class="n26" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Load projector file</text>
      </row>
    </row>
  </view>
  <row id="scanner-fast-row" align="center" min-height="48" row-gap="12" column-gap="12" clickable="true">
    <view id="scanner-fast" class="scanner-fast" grow="0" width="52" height="32" margin="3,2,3,2" padding="1" border-width="2" radius="16" clickable="true" label="Fast scan: read text first, use the model only when a field is missing">
      <view class="n29" width="16" height="16" position="absolute" top="6" left="6" radius="50%" clickable="true" unset="shrink right bottom" />
    </view>
    <text class="n30" clickable="true" font-size="14" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">Fast scan: read text first, use the model only when a field is missing</text>
  </row>
  <row id="scanner-gpu-row" align="center" min-height="48" row-gap="12" column-gap="12" clickable="true">
    <view id="scanner-gpu" class="scanner-gpu" grow="0" width="52" height="32" margin="3,2,3,2" padding="1" border-width="2" radius="16" clickable="true" label="Use GPU">
      <view class="n33" width="16" height="16" position="absolute" top="6" left="6" radius="50%" clickable="true" unset="shrink right bottom" />
    </view>
    <text id="scanner-gpu-label" class="scanner-gpu-label" clickable="true" font-size="14" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">Use GPU</text>
  </row>
  <text class="n35" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">Models run offline. Vouchers never leave this device.</text>
  <text id="model-status" class="model-status" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">Status</text>
</view>
