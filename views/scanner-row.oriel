<style>
  title: color=#191d19
  detail: color=#434a43
  badge: background=#c4ef9a color=#0f2b1d
  action: background=#dce7d6
  n8: color=#17241a
  n10: color=#ba1a1a
  progress: background=#2d6a4f
  @media (prefers-color-scheme: dark) {
    title: color=#e0e4dc
    detail: color=#c2c9c0
    badge: background=#2f4f22 color=#c4ef9a
    action: background=#384a3b
    n8: color=#d6e8d6
    n10: color=#ffb4ab
    progress: background=#9ad4ae
  }
</style>
<row id="scanner-row" wrap="wrap" justify="flex-start" align="center" width="100%" min-height="56" padding="12" row-gap="16" column-gap="16" radius="8" unset="shrink color font-size">
  <view grow="1" shrink="1" basis="60%" min-width="0">
    <text id="title" class="title" shrink="0" margin="0,0,2,0" font-size="15" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">{title}</text>
    <text id="detail" class="detail" shrink="0" margin="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="17.55">{detail}</text>
  </view>
  <row align="center" grow="0" row-gap="4" column-gap="4">
    <text id="badge" class="badge" padding="4,10,4,10" radius="8" font-size="12" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">In use</text>
    <row id="action" class="action" justify="center" align="center" min-height="36" padding="0,16,0,16" row-gap="8" column-gap="8" radius="20" clickable="true" unset="shrink">
      <text class="n8" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Download</text>
    </row>
    <row id="secondary" justify="center" align="center" min-height="36" padding="0,16,0,16" row-gap="8" column-gap="8" radius="20" clickable="true" unset="shrink">
      <text class="n10" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Delete</text>
    </row>
  </row>
  <view id="progress" class="progress" width="100%" height="3" position="absolute" bottom="4" left="12" radius="2" unset="shrink top right" />
</row>
