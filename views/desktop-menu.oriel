<style>
  menu: background=#eaeee4 border-color=#737a72
  edit: color=#191d19
  select: color=#191d19
  clear: color=#191d19
  cancel: color=#191d19
  @when (hover) {
    edit: background=#d0e4c5
    select: background=#d0e4c5
    clear: background=#d0e4c5
    cancel: background=#d0e4c5
  }
  @when (focus) {
    edit: outline=2,-2,#e59700 outline-halo=#111511
    select: outline=2,-2,#e59700 outline-halo=#111511
    clear: outline=2,-2,#e59700 outline-halo=#111511
    cancel: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<view id="menu" width="240" max-width="100%" max-height="100%" scroll="true" padding="8" border-width="1" radius="12" position="absolute" z="2147483647">
  <button id="edit" min-height="48" padding="12" clickable="true"><text font-size="16">Edit payment</text></button>
  <button id="select" min-height="48" padding="12" clickable="true"><text font-size="16">Select payment</text></button>
  <button id="clear" min-height="48" padding="12" clickable="true"><text font-size="16">Clear selection</text></button>
  <button id="cancel" min-height="48" padding="12" clickable="true"><text font-size="16">Cancel</text></button>
</view>
