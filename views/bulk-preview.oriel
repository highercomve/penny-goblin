<style>
  theme0: background=#eaeee4
  theme1: color=#191d19
  theme2: background=#2d6a4f
  @media (prefers-color-scheme: dark) {
    theme0: background=#1d211d
    theme1: color=#e0e4dc
    theme2: background=#9ad4ae
  }

  @when (hover) {
    cancel: background=#d0e4c5
    theme2: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    cancel: background=#384a3b
    theme2: background=#384a3b
  }
  @when (focus) {
    cancel: outline=2,-2,#e59700 outline-halo=#111511
    theme2: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
