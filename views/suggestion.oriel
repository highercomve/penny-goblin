<style>
  suggestion: color=#191d19
  @media (prefers-color-scheme: dark) {
    suggestion: color=#e0e4dc
  }

  @when (hover) {
    suggestion: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    suggestion: background=#384a3b
  }
  @when (focus) {
    suggestion: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<text id="suggestion" class="suggestion" shrink="0" padding="12,16,12,16" clickable="true" font-size="16" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif">{text}</text>
