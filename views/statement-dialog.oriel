<style>
  statement-dialog: grow=1 basis=0 width=640 height=auto min-height=0 max-width=1180 max-height=772 padding=0,24,24,24 color-scheme=light background=#eaeee4 radius=28 unset="position inset z"
  n3: margin=0,-24,8,-24 padding=8,16,0,8 background=#eaeee4
  n5: icon-color=#434a43 viewbox=0,0,24,24
  n7: color=#191d19
  confirm-statement: background=#2d6a4f
  n9: color=#ffffff
  statement-review-status: color=#434a43
  @media (prefers-color-scheme: dark) {
    statement-dialog: color-scheme=dark background=#1d211d
    n3: background=#1d211d
    n5: icon-color=#c2c9c0 viewbox=0,0,24,24
    n7: color=#e0e4dc
    confirm-statement: background=#9ad4ae
    n9: color=#003920
    statement-review-status: color=#c2c9c0
  }
  @media (max-width: 839px) {
    statement-dialog: width=393 height=820 max-width=393 max-height=820 padding=0,16,24,16 position=absolute top=0 right=0 bottom=0 left=0 background=#f6f8f1 z=2147483647 unset="grow basis min-height radius"
    n3: margin=0,-16,8,-16 padding=0,12,0,4 background=#f6f8f1
  }
  @media (max-width: 839px) and (prefers-color-scheme: dark) {
    statement-dialog: background=#111511
    n3: background=#111511
  }
  @media (max-width: 380px) {
    statement-dialog: width=320 height=820 max-width=320 max-height=820 padding=0,16,24,16 position=absolute top=0 right=0 bottom=0 left=0 background=#f6f8f1 z=2147483647 unset="grow basis min-height radius"
    n3: margin=0,-16,8,-16 padding=0,12,0,4 background=#f6f8f1
  }
  @media (max-width: 380px) and (prefers-color-scheme: dark) {
    statement-dialog: background=#111511
    n3: background=#111511
  }

  @when (hover) {
    apply-reviewed-through: background=#d0e4c5
    close-statement: background=#d0e4c5
    confirm-statement: background=#d0e4c5
    toggle-reviewed: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    apply-reviewed-through: background=#384a3b
    close-statement: background=#384a3b
    confirm-statement: background=#384a3b
    toggle-reviewed: background=#384a3b
  }
  @when (focus) {
    apply-reviewed-through: outline=2,-2,#e59700 outline-halo=#111511
    close-statement: outline=2,-2,#e59700 outline-halo=#111511
    confirm-statement: outline=2,-2,#e59700 outline-halo=#111511
    toggle-reviewed: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<view id="statement-dialog" class="statement-dialog" scroll="true" scroll-x="true" unset="shrink color font-size">
  <view id="statement-form" margin="0,0,8,0">
    <row class="n3" align="center" min-height="64" row-gap="4" column-gap="4" sticky="0,auto,auto,auto" z="2">
      <row id="close-statement" justify="center" align="center" width="48" height="48" min-height="48" row-gap="8" column-gap="8" radius="50%" clickable="true" unset="shrink">
        <icon class="n5" grow="0" shrink="0" width="24" height="24" clickable="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" linecap="round" linejoin="round" />
        </icon>
      </row>
      <view id="statement-title" grow="1" shrink="1" basis="0%" clip="true">
        <text class="n7" shrink="0" font-size="22" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true">Example statement</text>
      </view>
      <row id="confirm-statement" class="confirm-statement" justify="center" align="center" grow="0" min-height="48" padding="0,24,0,24" row-gap="8" column-gap="8" radius="20" clickable="true">
        <text class="n9" shrink="1" font-size="14" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" text-align="center" letter-spacing="0.1">Confirm</text>
      </row>
    </row>
    <text id="statement-review-status" class="statement-review-status" shrink="0" margin="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" line-height="18.85">Status</text>
    <text id="toggle-reviewed" clickable="true" min-height="48" padding="8" color="#2d6a4f">Show handled payments</text>
    <text font-size="13">Already entered older payments? Link exact matches and ignore other rows through this date. Confirm saves these choices.</text>
    <input id="reviewed-through" type="date" label="Already reviewed through" min-height="48" border-width="1" radius="8" padding="8" />
    <text id="apply-reviewed-through" clickable="true" min-height="48" padding="8">Mark older rows handled</text>
    <view id="statement-fields" min-width="0" margin="0">
      <view id="statement-rows" margin="0" />
    </view>
  </view>
</view>
