<style>
  payment-avatar: background=#dce7d6
  n3: color=#17241a
  n6: color=#191d19
  n8: color=#434a43
  n9: color=#191d19
  @media (prefers-color-scheme: dark) {
    payment-avatar: background=#384a3b
    n3: color=#d6e8d6
    n6: color=#e0e4dc
    n8: color=#c2c9c0
    n9: color=#e0e4dc
  }

  @when (hover) {
    n9: background=#d0e4c5
    payment: background=#d0e4c5
    payment-avatar: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    n9: background=#384a3b
    payment: background=#384a3b
    payment-avatar: background=#384a3b
  }
  @when (focus) {
    n9: outline=2,-2,#e59700 outline-halo=#111511
    payment: outline=2,-2,#e59700 outline-halo=#111511
    payment-avatar: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<row id="payment" justify="flex-start" align="center" width="100%" min-height="56" padding="10,8,10,8" row-gap="16" column-gap="16" radius="8" clickable="true" unset="shrink color font-size">
  <row id="payment-avatar" class="payment-avatar" justify="center" align="center" grow="0" width="40" height="40" radius="50%" clickable="true">
    <text class="n3" shrink="1" font-size="16" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" letter-spacing="0.1">{initial}</text>
  </row>
  <view grow="1" shrink="1" basis="0%" min-width="0" clickable="true">
    <view margin="0,0,2,0" clip="true" clickable="true">
      <text class="n6" shrink="0" font-size="15" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{payee}</text>
    </view>
    <view margin="0" clip="true" clickable="true">
      <text class="n8" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{detail}</text>
    </view>
  </view>
  <text class="n9" clickable="true" font-size="15" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{amount}</text>
</row>
