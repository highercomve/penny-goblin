<style>
  n5: color=#191d19
  n7: color=#434a43
  amount: color=#191d19
  @media (prefers-color-scheme: dark) {
    n5: color=#e0e4dc
    n7: color=#c2c9c0
    amount: color=#e0e4dc
  }

  @when (hover) {
    amount: background=#d0e4c5
    detail: background=#d0e4c5
    legend: background=#d0e4c5
    report-row: background=#d0e4c5
    title: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    amount: background=#384a3b
    detail: background=#384a3b
    legend: background=#384a3b
    report-row: background=#384a3b
    title: background=#384a3b
  }
  @when (focus) {
    amount: outline=2,-2,#e59700 outline-halo=#111511
    detail: outline=2,-2,#e59700 outline-halo=#111511
    legend: outline=2,-2,#e59700 outline-halo=#111511
    report-row: outline=2,-2,#e59700 outline-halo=#111511
    title: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<row id="report-row" justify="flex-start" align="center" width="100%" min-height="56" padding="8,4,8,4" row-gap="16" column-gap="16" radius="8" clickable="true" unset="color font-size">
  <view id="legend" grow="0" width="12" height="12" background="#2d6a4f" radius="50%" clickable="true" />
  <view grow="1" shrink="1" basis="0%" min-width="0" clickable="true">
    <view id="title" margin="0,0,2,0" clip="true" clickable="true">
      <text class="n5" shrink="0" font-size="15" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{title}</text>
    </view>
    <view id="detail" margin="0" clip="true" clickable="true">
      <text class="n7" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{detail}</text>
    </view>
  </view>
  <text id="amount" class="amount" clickable="true" font-size="15" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{amount}</text>
</row>
