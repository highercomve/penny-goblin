<style>
  ink: color=#191d19
  @media (prefers-color-scheme: dark) {
    ink: color=#e0e4dc
  }
</style>
<row class="ink" justify="space-between" align="center" gap="8" padding="12">
  <button id="previous" height="44" grow="1" basis="0%" min-width="0" max-width="110" justify="center" align="center" clickable="true"><text font-size="14" font-weight="500" text-align="center">Previous</text></button>
  <text shrink="0" text-align="center">{page}</text>
  <button id="next" height="44" grow="1" basis="0%" min-width="0" max-width="110" justify="center" align="center" clickable="true"><text font-size="14" font-weight="500" text-align="center">Next</text></button>
</row>
