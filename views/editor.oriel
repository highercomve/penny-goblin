  n40: direction=row row-gap=12 column-gap=12
  n41: shrink=1 basis=0%
  n42: color=#434a43
  field-amount: border-color=#737a72 color-scheme=light color=#191d19
  n44: shrink=1 basis=0%
  n45: color=#434a43
  field-date: border-color=#737a72 color-scheme=light color=#191d19
  n48: color=#434a43
  field-account: border-color=#737a72 color-scheme=light color=#191d19
  details-toggle: color=#2d6a4f
  n54: color=#434a43
