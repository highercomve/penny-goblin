<style>
  editor: grow=1 basis=0 width=640 height=auto min-height=0 max-width=1180 max-height=772 padding=0,24,24,24 color-scheme=light background=#eaeee4 radius=28 unset="position inset z"
  n3: margin=0,-24,8,-24 padding=8,16,0,8 background=#eaeee4
  n5: icon-color=#434a43 viewbox=0,0,24,24
  n7: color=#191d19
  save: background=#2d6a4f
  n9: color=#ffffff
  editor-status: color=#434a43
  n13: background=#eaeee4
  n14: icon-color=#2d6a4f viewbox=0,0,24,24
  n15: color=#191d19
  receipt-file: color-scheme=light background=#ffffff unset="color"
  n17: color-scheme=light color=#191d19
  camera-label: background=#eaeee4
  n19: icon-color=#2d6a4f viewbox=0,0,24,24
