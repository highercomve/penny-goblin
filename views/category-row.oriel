<style>
  n4: color=#191d19
  n6: color=#434a43
  amount: color=#191d19
  bar: background=#2d6a4f
  @media (prefers-color-scheme: dark) {
    n4: color=#e0e4dc
    n6: color=#c2c9c0
    amount: color=#e0e4dc
    bar: background=#9ad4ae
  }

  @when (hover) {
    amount: background=#d0e4c5
    bar: background=#d0e4c5
    category-row: background=#d0e4c5
    detail: background=#d0e4c5
    title: background=#d0e4c5
  }
  @when (hover) and (prefers-color-scheme: dark) {
    amount: background=#384a3b
    bar: background=#384a3b
    category-row: background=#384a3b
    detail: background=#384a3b
    title: background=#384a3b
  }
  @when (focus) {
    amount: outline=2,-2,#e59700 outline-halo=#111511
    bar: outline=2,-2,#e59700 outline-halo=#111511
    category-row: outline=2,-2,#e59700 outline-halo=#111511
    detail: outline=2,-2,#e59700 outline-halo=#111511
    title: outline=2,-2,#e59700 outline-halo=#111511
  }
</style>
<row id="category-row" justify="flex-start" align="center" width="100%" min-height="56" padding="8,4,14,4" row-gap="16" column-gap="16" radius="8" clickable="true" unset="shrink color font-size">
  <view grow="1" shrink="1" basis="0%" min-width="0" clickable="true">
    <view id="title" margin="0,0,2,0" clip="true" clickable="true">
      <text class="n4" shrink="0" font-size="15" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{title}</text>
    </view>
    <view id="detail" margin="0" clip="true" clickable="true">
      <text class="n6" shrink="0" font-size="13" font-weight="400" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{detail}</text>
    </view>
  </view>
  <text id="amount" class="amount" clickable="true" font-size="15" font-weight="500" font-family="Roboto, Google Sans, system-ui, -apple-system, Segoe UI, sans-serif" nowrap="true" letter-spacing="0.1">{amount}</text>
  <view id="bar" class="bar" width="100%" height="4" position="absolute" bottom="4" left="4" radius="2" clickable="true" unset="shrink top right" />
</row>
